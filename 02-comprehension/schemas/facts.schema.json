{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "facts.yaml",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "fact"],
    "properties": {
      "id": { "type": "string", "pattern": "^f[0-9]{2,}$" },
      "fact": { "type": "string", "minLength": 1 }
    }
  }
}
