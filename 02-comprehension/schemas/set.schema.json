{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "set.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["set_id", "title", "description", "members", "versions"],
  "properties": {
    "set_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "covers": { "type": "string" },
    "how_members_differ": { "type": "string" },
    "members": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "source_url", "license", "author", "date_pulled"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "author": { "type": "string", "minLength": 1 },
          "date_pulled": { "type": "string", "format": "date" },
          "notes": { "type": "string" }
        }
      }
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
